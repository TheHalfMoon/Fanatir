{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fanatir",
  "version": "0.0.0",
  "identifier": "com.fanatir.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../../afia-ui run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "pnpm --dir ../../afia-ui run build",
    "frontendDist": "../../afia-ui/dist/public"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fanatir",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "visible": true,
        "decorations": true,
        "alwaysOnTop": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* http://localhost:* ws://127.0.0.1:* ws://localhost:*; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:"
    }
  },
  "bundle": {
    "active": false,
    "targets": [],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
